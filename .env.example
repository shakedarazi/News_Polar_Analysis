# PostgreSQL connection (required for crawling)
DATABASE_URL=postgresql://news:news@localhost:5432/news_polar

# OpenAI (required for article classification/summary/bias/Q&A)
OPENAI_API_KEY=sk-your-key-here

# Optional: point at an OpenAI-compatible gateway instead of api.openai.com,
# e.g. OpenRouter. Leave both unset to use OpenAI directly. If set, OPENAI_MODEL
# must use that gateway's model id format (OpenRouter: "openai/gpt-4o-mini",
# not bare "gpt-4o-mini").
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini
