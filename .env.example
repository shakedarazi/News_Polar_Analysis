# PostgreSQL connection (required for crawling)
DATABASE_URL=postgresql://news:news@localhost:5432/news_polar

# User-facing AI (summary / bias / Q&A via the API) — a real OpenAI key.
# Hits api.openai.com. Do not set OPENAI_BASE_URL here.
OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini

# Ingestion/classify only (pipeline/classify_articles.py) — the existing
# OpenRouter key. Separate credit pool from user-facing OpenAI.
OPENAI_INGESTION_API_KEY=sk-or-v1-your-openrouter-key-here
OPENAI_INGESTION_BASE_URL=https://openrouter.ai/api/v1
OPENAI_INGESTION_MODEL=openai/gpt-4o-mini

# Retrieval embeddings — must be a real OpenAI key, not OpenRouter.
#
# The assistant compares a question's vector against the corpus's chunk
# vectors, so both have to come from the same model at the same provider:
# ingestion embeds the chunks, the API embeds the question. Falls back to
# OPENAI_API_KEY when unset, which is right on the API host (same key) and
# finds nothing on the ingestion runner (where only the OpenRouter key is
# injected) — so a misconfiguration is an error rather than two vector spaces
# quietly mixed in one column.
#
# Without it the assistant still answers, on keyword matching alone, and says
# so. See src/rag/embedding.py.
OPENAI_EMBEDDING_API_KEY=sk-your-openai-key-here
