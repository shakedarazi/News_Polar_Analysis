# PostgreSQL connection (required for crawling)
DATABASE_URL=postgresql://news:news@localhost:5432/news_polar

# User-facing AI (summary / bias / Q&A via the API) — a real OpenAI key.
# Hits api.openai.com. Do not set OPENAI_BASE_URL here.
OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini

# Ingestion/classify only (pipeline/classify_articles.py) — the existing
# OpenRouter key. Separate credit pool from user-facing OpenAI.
OPENAI_INGESTION_API_KEY=sk-or-v1-your-openrouter-key-here
OPENAI_INGESTION_BASE_URL=https://openrouter.ai/api/v1
OPENAI_INGESTION_MODEL=openai/gpt-4o-mini

# The assistant's retrieval embeddings need no key of their own: questions are
# embedded on OPENAI_API_KEY, chunks on OPENAI_INGESTION_API_KEY, and both
# gateways serve OpenAI's text-embedding-3-small. See src/rag/embedding.py.
#
# Locally that means pipeline/embed_chunks.py spends the OpenRouter key, the
# same one classify uses.
